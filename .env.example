# ==============================================================================
# ClubPro Connect (mobile) — variables d'environnement
# Copie ce fichier en `.env` (lu par app.config.ts via `expo-constants` / Metro).
# Seules les variables préfixées EXPO_PUBLIC_ sont embarquées dans le bundle
# client — tout le reste (clés IA, service_role, CRON_SECRET) ne doit vivre
# QUE côté Supabase Edge Functions (voir supabase/functions/.env).
# ==============================================================================

# --- Supabase (obligatoire) ---------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Feature flags (lues côté client pour afficher/masquer des features) ------
EXPO_PUBLIC_FEATURE_EA_STATS="true"
EXPO_PUBLIC_FEATURE_AI="true"
EXPO_PUBLIC_FEATURE_REVENUECAT="false"

# --- RevenueCat (abonnement Pro 5€/mois, in-app purchase) ---------------------
# Clés PUBLIQUES du SDK (une par plateforme) — voir README > "Brancher RevenueCat".
EXPO_PUBLIC_REVENUECAT_IOS_KEY="appl_placeholder"
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY="goog_placeholder"

# ==============================================================================
# Variables SERVEUR — à renseigner dans Supabase (Project Settings > Edge
# Functions > Secrets), JAMAIS dans ce fichier .env mobile. Listées ici pour
# référence uniquement :
#
#   SUPABASE_SERVICE_ROLE_KEY   accès admin (bypass RLS) pour les jobs cron
#   DATABASE_URL / DIRECT_URL   connexion Postgres pour Prisma (migrate/seed)
#   CRON_SECRET                  secret partagé pour déclencher les crons
#   AI_API_KEY / AI_API_BASE_URL / AI_MODEL   provider IA (Smart Match, Scout Report)
#   REVENUECAT_WEBHOOK_SECRET     vérifie les webhooks RevenueCat -> Supabase
#   EA_HTTP_HOP_URL / EA_HTTP_HOP_SECRET   hop Node CPC (Edge → Node, jamais RN)
#   EA_FC_BASE_URL                 https://proclubs.ea.com/api/fc — pas /api/fc27
# ==============================================================================
